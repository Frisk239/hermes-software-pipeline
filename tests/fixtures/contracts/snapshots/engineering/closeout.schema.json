{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.hermes-pipeline.dev/engineering/closeout/v1",
  "title": "Engineering Closeout",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "schema_version", "closeout_id", "scope_kind", "scope_id", "base_sha", "accepted_sha", "delivered", "evidence", "residual_debt", "next_prerequisites", "closed_at", "content_hash"],
  "properties": {
    "schema_id": {"const": "https://schemas.hermes-pipeline.dev/engineering/closeout/v1"},
    "schema_version": {"const": 1},
    "closeout_id": {"type": "string", "pattern": "^close_[A-Za-z0-9_-]+$"},
    "scope_kind": {"enum": ["SLICE", "PHASE"]},
    "scope_id": {"type": "string"},
    "base_sha": {"$ref": "https://schemas.hermes-pipeline.dev/common/definitions/v1#/$defs/gitSha"},
    "accepted_sha": {"$ref": "https://schemas.hermes-pipeline.dev/common/definitions/v1#/$defs/gitSha"},
    "delivered": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "https://schemas.hermes-pipeline.dev/common/definitions/v1#/$defs/artifactReference"}},
    "residual_debt": {"type": "array", "items": {"type": "string"}},
    "next_prerequisites": {"type": "array", "items": {"type": "string"}},
    "closed_at": {"$ref": "https://schemas.hermes-pipeline.dev/common/definitions/v1#/$defs/utcTimestamp"},
    "content_hash": {"$ref": "https://schemas.hermes-pipeline.dev/common/definitions/v1#/$defs/sha256"}
  }
}
