{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.hermes-pipeline.dev/common/definitions/v1",
  "title": "Hermes Pipeline Common Definitions",
  "$defs": {
    "utcTimestamp": {
      "type": "string",
      "format": "date-time"
    },
    "gitSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    },
    "identity": {
      "type": "string",
      "minLength": 4,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9_-]*_[A-Za-z0-9_-]+$"
    },
    "schemaIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_id", "schema_version"],
      "properties": {
        "schema_id": {
          "type": "string",
          "format": "uri"
        },
        "schema_version": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "fileReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "digest", "purpose"],
      "properties": {
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "digest": {
          "$ref": "#/$defs/sha256"
        },
        "purpose": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "artifactReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "manifest_digest", "role"],
      "properties": {
        "artifact_id": {
          "type": "string",
          "pattern": "^art_[A-Za-z0-9_-]+$"
        },
        "manifest_digest": {
          "$ref": "#/$defs/sha256"
        },
        "role": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "engineeringRisk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["risk_id", "description", "impact", "mitigation", "trigger"],
      "properties": {
        "risk_id": {
          "type": "string",
          "pattern": "^R-[0-9]{2,}$"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "impact": {
          "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]
        },
        "mitigation": {
          "type": "string",
          "minLength": 1
        },
        "trigger": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
