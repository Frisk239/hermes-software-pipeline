{
  "$id": "https://schemas.hermes-pipeline.dev/engineering/context-manifest/v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "assembled_at": {
      "$ref": "https://schemas.hermes-pipeline.dev/common/definitions/v1#/$defs/utcTimestamp"
    },
    "base_sha": {
      "$ref": "https://schemas.hermes-pipeline.dev/common/definitions/v1#/$defs/gitSha"
    },
    "content_hash": {
      "$ref": "https://schemas.hermes-pipeline.dev/common/definitions/v1#/$defs/sha256"
    },
    "facts": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "value": {
            "type": [
              "string",
              "integer",
              "boolean"
            ]
          }
        },
        "required": [
          "name",
          "value",
          "source"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "files": {
      "items": {
        "$ref": "https://schemas.hermes-pipeline.dev/common/definitions/v1#/$defs/fileReference"
      },
      "minItems": 1,
      "type": "array"
    },
    "manifest_id": {
      "pattern": "^ctx_[A-Za-z0-9_-]+$",
      "type": "string"
    },
    "role": {
      "enum": [
        "PLANNER",
        "EXECUTOR",
        "REVIEWER"
      ]
    },
    "schema_id": {
      "const": "https://schemas.hermes-pipeline.dev/engineering/context-manifest/v1"
    },
    "schema_version": {
      "const": 1
    },
    "slice_id": {
      "type": "string"
    }
  },
  "required": [
    "schema_id",
    "schema_version",
    "manifest_id",
    "role",
    "slice_id",
    "base_sha",
    "assembled_at",
    "files",
    "facts",
    "content_hash"
  ],
  "title": "Engineering Context Manifest",
  "type": "object"
}
