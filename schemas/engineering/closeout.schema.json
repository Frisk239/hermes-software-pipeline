{
  "$id": "https://schemas.hermes-pipeline.dev/engineering/closeout/v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "accepted_sha": {
      "$ref": "https://schemas.hermes-pipeline.dev/common/definitions/v1#/$defs/gitSha"
    },
    "base_sha": {
      "$ref": "https://schemas.hermes-pipeline.dev/common/definitions/v1#/$defs/gitSha"
    },
    "closed_at": {
      "$ref": "https://schemas.hermes-pipeline.dev/common/definitions/v1#/$defs/utcTimestamp"
    },
    "closeout_id": {
      "pattern": "^close_[A-Za-z0-9_-]+$",
      "type": "string"
    },
    "content_hash": {
      "$ref": "https://schemas.hermes-pipeline.dev/common/definitions/v1#/$defs/sha256"
    },
    "delivered": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "evidence": {
      "items": {
        "$ref": "https://schemas.hermes-pipeline.dev/common/definitions/v1#/$defs/artifactReference"
      },
      "minItems": 1,
      "type": "array"
    },
    "next_prerequisites": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "residual_debt": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "schema_id": {
      "const": "https://schemas.hermes-pipeline.dev/engineering/closeout/v1"
    },
    "schema_version": {
      "const": 1
    },
    "scope_id": {
      "type": "string"
    },
    "scope_kind": {
      "enum": [
        "SLICE",
        "PHASE"
      ]
    }
  },
  "required": [
    "schema_id",
    "schema_version",
    "closeout_id",
    "scope_kind",
    "scope_id",
    "base_sha",
    "accepted_sha",
    "delivered",
    "evidence",
    "residual_debt",
    "next_prerequisites",
    "closed_at",
    "content_hash"
  ],
  "title": "Engineering Closeout",
  "type": "object"
}
