{
  "$id": "https://schemas.hermes-pipeline.dev/engineering/slice-contract/v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "acceptance_criteria": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "criterion_id": {
            "pattern": "^AC-[0-9]{2,}$",
            "type": "string"
          },
          "observable_result": {
            "minLength": 1,
            "type": "string"
          },
          "trace_ids": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "minItems": 1,
            "type": "array",
            "uniqueItems": true
          },
          "verification_command_ids": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "minItems": 1,
            "type": "array",
            "uniqueItems": true
          }
        },
        "required": [
          "criterion_id",
          "trace_ids",
          "observable_result",
          "verification_command_ids"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "assigned_worktree": {
      "maxLength": 1024,
      "minLength": 1,
      "type": "string"
    },
    "base_sha": {
      "$ref": "https://schemas.hermes-pipeline.dev/common/definitions/v1#/$defs/gitSha"
    },
    "binding_adrs": {
      "items": {
        "pattern": "^ADR-[0-9]{4}$",
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "content_hash": {
      "$ref": "https://schemas.hermes-pipeline.dev/common/definitions/v1#/$defs/sha256"
    },
    "demonstration": {
      "minLength": 1,
      "type": "string"
    },
    "document_revision": {
      "minimum": 1,
      "type": "integer"
    },
    "implications": {
      "additionalProperties": false,
      "properties": {
        "compatibility": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        },
        "data": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        },
        "documentation": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        },
        "migration": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        },
        "security": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "data",
        "migration",
        "compatibility",
        "security",
        "documentation"
      ],
      "type": "object"
    },
    "interfaces": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "must_scope": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "operator_path": {
      "minLength": 1,
      "type": "string"
    },
    "out_of_scope": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "permitted_paths": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "phase_id": {
      "pattern": "^phase-[0-9]{2,}$",
      "type": "string"
    },
    "predecessors": {
      "items": {
        "pattern": "^slice-[0-9]{2,}-[0-9]{2,}$",
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "prohibited_actions": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "required_evidence": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "required_tests": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "retry_budget": {
      "maximum": 10,
      "minimum": 0,
      "type": "integer"
    },
    "risks": {
      "items": {
        "$ref": "https://schemas.hermes-pipeline.dev/common/definitions/v1#/$defs/engineeringRisk"
      },
      "type": "array"
    },
    "schema_id": {
      "const": "https://schemas.hermes-pipeline.dev/engineering/slice-contract/v1"
    },
    "schema_version": {
      "const": 1
    },
    "slice_id": {
      "pattern": "^slice-[0-9]{2,}-[0-9]{2,}$",
      "type": "string"
    },
    "status": {
      "enum": [
        "DRAFT",
        "READY",
        "EXECUTING",
        "SUBMITTED",
        "ACCEPTED",
        "REWORK",
        "BLOCKED"
      ]
    },
    "stop_conditions": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "verification_commands": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "argv": {
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "type": "array"
          },
          "command_id": {
            "minLength": 1,
            "type": "string"
          },
          "timeout_ms": {
            "maximum": 3600000,
            "minimum": 1000,
            "type": "integer"
          },
          "working_directory": {
            "$ref": "https://schemas.hermes-pipeline.dev/common/definitions/v1#/$defs/relativePath"
          }
        },
        "required": [
          "command_id",
          "argv",
          "working_directory",
          "timeout_ms"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    }
  },
  "required": [
    "schema_id",
    "schema_version",
    "document_revision",
    "slice_id",
    "phase_id",
    "status",
    "predecessors",
    "base_sha",
    "assigned_worktree",
    "operator_path",
    "must_scope",
    "out_of_scope",
    "interfaces",
    "binding_adrs",
    "permitted_paths",
    "prohibited_actions",
    "implications",
    "acceptance_criteria",
    "required_tests",
    "demonstration",
    "verification_commands",
    "required_evidence",
    "risks",
    "retry_budget",
    "stop_conditions",
    "content_hash"
  ],
  "title": "Engineering Slice Contract",
  "type": "object"
}
