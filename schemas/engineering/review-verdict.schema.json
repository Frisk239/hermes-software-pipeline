{
  "$id": "https://schemas.hermes-pipeline.dev/engineering/review-verdict/v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "verdict": {
            "const": "PASS"
          }
        }
      },
      "then": {
        "properties": {
          "axes": {
            "properties": {
              "evidence": {
                "const": "PASS"
              },
              "scope_safety": {
                "const": "PASS"
              },
              "spec": {
                "const": "PASS"
              },
              "standards": {
                "const": "PASS"
              }
            }
          },
          "findings": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "verdict": {
            "enum": [
              "REWORK",
              "BLOCKED_CONTRACT"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "findings": {
            "minItems": 1
          }
        }
      }
    }
  ],
  "properties": {
    "axes": {
      "additionalProperties": false,
      "properties": {
        "evidence": {
          "enum": [
            "PASS",
            "FAIL",
            "BLOCKED"
          ]
        },
        "scope_safety": {
          "enum": [
            "PASS",
            "FAIL",
            "BLOCKED"
          ]
        },
        "spec": {
          "enum": [
            "PASS",
            "FAIL",
            "BLOCKED"
          ]
        },
        "standards": {
          "enum": [
            "PASS",
            "FAIL",
            "BLOCKED"
          ]
        }
      },
      "required": [
        "spec",
        "standards",
        "evidence",
        "scope_safety"
      ],
      "type": "object"
    },
    "base_sha": {
      "$ref": "https://schemas.hermes-pipeline.dev/common/definitions/v1#/$defs/gitSha"
    },
    "candidate_sha": {
      "$ref": "https://schemas.hermes-pipeline.dev/common/definitions/v1#/$defs/gitSha"
    },
    "content_hash": {
      "$ref": "https://schemas.hermes-pipeline.dev/common/definitions/v1#/$defs/sha256"
    },
    "context_manifest_hash": {
      "$ref": "https://schemas.hermes-pipeline.dev/common/definitions/v1#/$defs/sha256"
    },
    "contract_revision": {
      "minimum": 1,
      "type": "integer"
    },
    "evidence_bundle_hash": {
      "$ref": "https://schemas.hermes-pipeline.dev/common/definitions/v1#/$defs/sha256"
    },
    "findings": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "axis": {
            "enum": [
              "SPEC",
              "STANDARDS",
              "EVIDENCE",
              "SCOPE_SAFETY"
            ]
          },
          "evidence": {
            "minLength": 1,
            "type": "string"
          },
          "finding_id": {
            "pattern": "^F-[0-9]{2,}$",
            "type": "string"
          },
          "required_correction": {
            "minLength": 1,
            "type": "string"
          },
          "requirement_ref": {
            "minLength": 1,
            "type": "string"
          },
          "severity": {
            "enum": [
              "BLOCKER",
              "MAJOR",
              "MINOR"
            ]
          }
        },
        "required": [
          "finding_id",
          "severity",
          "axis",
          "evidence",
          "requirement_ref",
          "required_correction"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "review_attempt": {
      "minimum": 1,
      "type": "integer"
    },
    "reviewed_at": {
      "$ref": "https://schemas.hermes-pipeline.dev/common/definitions/v1#/$defs/utcTimestamp"
    },
    "schema_id": {
      "const": "https://schemas.hermes-pipeline.dev/engineering/review-verdict/v1"
    },
    "schema_version": {
      "const": 1
    },
    "slice_id": {
      "type": "string"
    },
    "verdict": {
      "enum": [
        "PASS",
        "REWORK",
        "BLOCKED_CONTRACT"
      ]
    },
    "verdict_id": {
      "pattern": "^review_[A-Za-z0-9_-]+$",
      "type": "string"
    }
  },
  "required": [
    "schema_id",
    "schema_version",
    "verdict_id",
    "slice_id",
    "contract_revision",
    "review_attempt",
    "base_sha",
    "candidate_sha",
    "context_manifest_hash",
    "evidence_bundle_hash",
    "verdict",
    "axes",
    "findings",
    "reviewed_at",
    "content_hash"
  ],
  "title": "Engineering Review Verdict",
  "type": "object"
}
