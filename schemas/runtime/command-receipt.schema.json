{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.hermes-pipeline.dev/runtime/command-receipt/v1",
  "title": "Command Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "schema_version", "command_id", "status", "pipeline_id", "observed_revision", "recorded_at", "correlation_id"],
  "properties": {
    "schema_id": {"const": "https://schemas.hermes-pipeline.dev/runtime/command-receipt/v1"},
    "schema_version": {"const": 1},
    "command_id": {"type": "string"},
    "status": {"enum": ["ACCEPTED", "REJECTED", "CONFLICT", "DEDUPLICATED"]},
    "pipeline_id": {"type": "string"},
    "observed_revision": {"type": "integer", "minimum": 0},
    "event_ids": {"type": "array", "items": {"type": "string"}},
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "retryable"],
      "properties": {
        "code": {"enum": ["VALIDATION_ERROR", "AUTHENTICATION_FAILED", "AUTHORIZATION_DENIED", "NOT_FOUND", "CONFLICT", "POLICY_REJECTED", "LEASE_STALE", "DEPENDENCY_UNAVAILABLE", "RATE_LIMITED", "INTERNAL_ERROR"]},
        "message": {"type": "string"},
        "retryable": {"type": "boolean"},
        "field_violations": {"type": "array", "items": {"type": "string"}}
      }
    },
    "recorded_at": {"$ref": "https://schemas.hermes-pipeline.dev/common/definitions/v1#/$defs/utcTimestamp"},
    "correlation_id": {"type": "string"}
  }
}
