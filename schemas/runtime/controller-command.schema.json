{
  "$id": "https://schemas.hermes-pipeline.dev/runtime/controller-command/v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "actor": {
      "additionalProperties": false,
      "properties": {
        "principal_id": {
          "type": "string"
        },
        "provider": {
          "enum": [
            "CLI",
            "FEISHU",
            "SYSTEM",
            "GITHUB"
          ]
        },
        "provider_actor_id": {
          "type": "string"
        }
      },
      "required": [
        "principal_id",
        "provider",
        "provider_actor_id"
      ],
      "type": "object"
    },
    "causation_id": {
      "type": "string"
    },
    "command_id": {
      "pattern": "^cmd_[A-Za-z0-9_-]+$",
      "type": "string"
    },
    "command_type": {
      "pattern": "^[A-Z][A-Z0-9_]+$",
      "type": "string"
    },
    "correlation_id": {
      "type": "string"
    },
    "expected_revision": {
      "minimum": 0,
      "type": "integer"
    },
    "idempotency_key": {
      "maxLength": 160,
      "minLength": 16,
      "type": "string"
    },
    "ingress": {
      "enum": [
        "CLI",
        "HERMES_FEISHU",
        "SYSTEM_RECONCILER",
        "GITHUB_RECONCILER"
      ]
    },
    "payload": {
      "type": "object"
    },
    "pipeline_id": {
      "pattern": "^pl_[A-Za-z0-9_-]+$",
      "type": "string"
    },
    "project_id": {
      "pattern": "^prj_[A-Za-z0-9_-]+$",
      "type": "string"
    },
    "schema_id": {
      "const": "https://schemas.hermes-pipeline.dev/runtime/controller-command/v1"
    },
    "schema_version": {
      "const": 1
    },
    "submitted_at": {
      "$ref": "https://schemas.hermes-pipeline.dev/common/definitions/v1#/$defs/utcTimestamp"
    },
    "workspace_id": {
      "pattern": "^ws_[A-Za-z0-9_-]+$",
      "type": "string"
    }
  },
  "required": [
    "schema_id",
    "schema_version",
    "command_id",
    "idempotency_key",
    "workspace_id",
    "project_id",
    "pipeline_id",
    "expected_revision",
    "actor",
    "ingress",
    "command_type",
    "payload",
    "correlation_id",
    "submitted_at"
  ],
  "title": "Controller Command",
  "type": "object"
}
