{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.hermes-pipeline.dev/runtime/controller-command/v1",
  "title": "Controller Command",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "schema_version", "command_id", "idempotency_key", "workspace_id", "project_id", "pipeline_id", "expected_revision", "actor", "ingress", "command_type", "payload", "correlation_id", "submitted_at"],
  "properties": {
    "schema_id": {"const": "https://schemas.hermes-pipeline.dev/runtime/controller-command/v1"},
    "schema_version": {"const": 1},
    "command_id": {"type": "string", "pattern": "^cmd_[A-Za-z0-9_-]+$"},
    "idempotency_key": {"type": "string", "minLength": 16, "maxLength": 160},
    "workspace_id": {"type": "string", "pattern": "^ws_[A-Za-z0-9_-]+$"},
    "project_id": {"type": "string", "pattern": "^prj_[A-Za-z0-9_-]+$"},
    "pipeline_id": {"type": "string", "pattern": "^pl_[A-Za-z0-9_-]+$"},
    "expected_revision": {"type": "integer", "minimum": 0},
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["principal_id", "provider", "provider_actor_id"],
      "properties": {
        "principal_id": {"type": "string"},
        "provider": {"enum": ["CLI", "FEISHU", "SYSTEM", "GITHUB"]},
        "provider_actor_id": {"type": "string"}
      }
    },
    "ingress": {"enum": ["CLI", "HERMES_FEISHU", "SYSTEM_RECONCILER", "GITHUB_RECONCILER"]},
    "command_type": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]+$"},
    "payload": {"type": "object"},
    "correlation_id": {"type": "string"},
    "causation_id": {"type": "string"},
    "submitted_at": {"$ref": "https://schemas.hermes-pipeline.dev/common/definitions/v1#/$defs/utcTimestamp"}
  }
}
