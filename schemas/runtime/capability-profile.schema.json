{
  "$id": "https://schemas.hermes-pipeline.dev/runtime/capability-profile/v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "browser": {
      "enum": [
        "NONE",
        "CHROME_DEVTOOLS_MCP"
      ]
    },
    "content_hash": {
      "$ref": "https://schemas.hermes-pipeline.dev/common/definitions/v1#/$defs/sha256"
    },
    "executables": {
      "items": {
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "filesystem": {
      "additionalProperties": false,
      "properties": {
        "read_roots": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "write_roots": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "read_roots",
        "write_roots"
      ],
      "type": "object"
    },
    "network": {
      "additionalProperties": false,
      "properties": {
        "allow": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "mode": {
          "enum": [
            "DENY_ALL",
            "ALLOW_LIST"
          ]
        }
      },
      "required": [
        "mode",
        "allow"
      ],
      "type": "object"
    },
    "profile_id": {
      "pattern": "^cap_[A-Za-z0-9_-]+$",
      "type": "string"
    },
    "profile_revision": {
      "minimum": 1,
      "type": "integer"
    },
    "resources": {
      "additionalProperties": false,
      "properties": {
        "output_bytes": {
          "minimum": 1024,
          "type": "integer"
        },
        "processes": {
          "minimum": 1,
          "type": "integer"
        },
        "wall_time_ms": {
          "minimum": 1000,
          "type": "integer"
        }
      },
      "required": [
        "wall_time_ms",
        "output_bytes",
        "processes"
      ],
      "type": "object"
    },
    "schema_id": {
      "const": "https://schemas.hermes-pipeline.dev/runtime/capability-profile/v1"
    },
    "schema_version": {
      "const": 1
    },
    "secrets": {
      "items": {
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "side_effects": {
      "items": {
        "enum": [
          "NONE",
          "LOCAL_BUILD",
          "LOCAL_TEST",
          "BROWSER_TEST"
        ]
      },
      "type": "array",
      "uniqueItems": true
    },
    "stage_type": {
      "enum": [
        "PRD",
        "ARCHITECTURE",
        "DEVELOPMENT",
        "E2E",
        "ACCEPTANCE"
      ]
    }
  },
  "required": [
    "schema_id",
    "schema_version",
    "profile_id",
    "profile_revision",
    "stage_type",
    "filesystem",
    "executables",
    "network",
    "secrets",
    "browser",
    "resources",
    "side_effects",
    "content_hash"
  ],
  "title": "Stage Capability Profile",
  "type": "object"
}
