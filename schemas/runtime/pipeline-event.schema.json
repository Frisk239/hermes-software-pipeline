{
  "$id": "https://schemas.hermes-pipeline.dev/runtime/pipeline-event/v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "actor_id": {
      "type": "string"
    },
    "authorization_decision_id": {
      "type": "string"
    },
    "causation_id": {
      "type": "string"
    },
    "command_id": {
      "type": "string"
    },
    "correlation_id": {
      "type": "string"
    },
    "event_hash": {
      "$ref": "https://schemas.hermes-pipeline.dev/common/definitions/v1#/$defs/sha256"
    },
    "event_id": {
      "pattern": "^evt_[A-Za-z0-9_-]+$",
      "type": "string"
    },
    "event_schema_version": {
      "minimum": 1,
      "type": "integer"
    },
    "event_type": {
      "pattern": "^[A-Z][A-Z0-9_]+$",
      "type": "string"
    },
    "occurred_at": {
      "$ref": "https://schemas.hermes-pipeline.dev/common/definitions/v1#/$defs/utcTimestamp"
    },
    "payload": {
      "type": "object"
    },
    "pipeline_id": {
      "type": "string"
    },
    "pipeline_revision": {
      "minimum": 1,
      "type": "integer"
    },
    "previous_event_hash": {
      "anyOf": [
        {
          "$ref": "https://schemas.hermes-pipeline.dev/common/definitions/v1#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "project_id": {
      "type": "string"
    },
    "recorded_at": {
      "$ref": "https://schemas.hermes-pipeline.dev/common/definitions/v1#/$defs/utcTimestamp"
    },
    "schema_id": {
      "const": "https://schemas.hermes-pipeline.dev/runtime/pipeline-event/v1"
    },
    "schema_version": {
      "const": 1
    },
    "workspace_id": {
      "type": "string"
    }
  },
  "required": [
    "schema_id",
    "schema_version",
    "event_id",
    "workspace_id",
    "project_id",
    "pipeline_id",
    "pipeline_revision",
    "event_type",
    "event_schema_version",
    "actor_id",
    "authorization_decision_id",
    "command_id",
    "correlation_id",
    "payload",
    "occurred_at",
    "recorded_at",
    "previous_event_hash",
    "event_hash"
  ],
  "title": "Pipeline Event",
  "type": "object"
}
