{
  "$id": "https://schemas.hermes-pipeline.dev/runtime/evidence-bundle/v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifacts": {
      "items": {
        "$ref": "https://schemas.hermes-pipeline.dev/common/definitions/v1#/$defs/artifactReference"
      },
      "minItems": 1,
      "type": "array"
    },
    "bundle_digest": {
      "$ref": "https://schemas.hermes-pipeline.dev/common/definitions/v1#/$defs/sha256"
    },
    "bundle_id": {
      "pattern": "^evb_[A-Za-z0-9_-]+$",
      "type": "string"
    },
    "contract_revision": {
      "minimum": 1,
      "type": "integer"
    },
    "created_at": {
      "$ref": "https://schemas.hermes-pipeline.dev/common/definitions/v1#/$defs/utcTimestamp"
    },
    "execution_run_id": {
      "pattern": "^run_[A-Za-z0-9_-]+$",
      "type": "string"
    },
    "lease_generation": {
      "minimum": 1,
      "type": "integer"
    },
    "pipeline_id": {
      "pattern": "^pl_[A-Za-z0-9_-]+$",
      "type": "string"
    },
    "schema_id": {
      "const": "https://schemas.hermes-pipeline.dev/runtime/evidence-bundle/v1"
    },
    "schema_version": {
      "const": 1
    },
    "source_identity": {
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "candidate_sha": {
          "$ref": "https://schemas.hermes-pipeline.dev/common/definitions/v1#/$defs/gitSha"
        },
        "integration_candidate_sha": {
          "$ref": "https://schemas.hermes-pipeline.dev/common/definitions/v1#/$defs/gitSha"
        },
        "planning_base_sha": {
          "$ref": "https://schemas.hermes-pipeline.dev/common/definitions/v1#/$defs/gitSha"
        }
      },
      "type": "object"
    },
    "stage_attempt_id": {
      "pattern": "^att_[A-Za-z0-9_-]+$",
      "type": "string"
    }
  },
  "required": [
    "schema_id",
    "schema_version",
    "bundle_id",
    "pipeline_id",
    "stage_attempt_id",
    "execution_run_id",
    "lease_generation",
    "source_identity",
    "contract_revision",
    "artifacts",
    "created_at",
    "bundle_digest"
  ],
  "title": "Evidence Bundle",
  "type": "object"
}
