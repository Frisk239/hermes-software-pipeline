{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.hermes-pipeline.dev/runtime/evidence-bundle/v1",
  "title": "Evidence Bundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "schema_version", "bundle_id", "pipeline_id", "stage_attempt_id", "execution_run_id", "lease_generation", "source_identity", "contract_revision", "artifacts", "created_at", "bundle_digest"],
  "properties": {
    "schema_id": {"const": "https://schemas.hermes-pipeline.dev/runtime/evidence-bundle/v1"},
    "schema_version": {"const": 1},
    "bundle_id": {"type": "string", "pattern": "^evb_[A-Za-z0-9_-]+$"},
    "pipeline_id": {"type": "string", "pattern": "^pl_[A-Za-z0-9_-]+$"},
    "stage_attempt_id": {"type": "string", "pattern": "^att_[A-Za-z0-9_-]+$"},
    "execution_run_id": {"type": "string", "pattern": "^run_[A-Za-z0-9_-]+$"},
    "lease_generation": {"type": "integer", "minimum": 1},
    "source_identity": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "planning_base_sha": {"$ref": "https://schemas.hermes-pipeline.dev/common/definitions/v1#/$defs/gitSha"},
        "candidate_sha": {"$ref": "https://schemas.hermes-pipeline.dev/common/definitions/v1#/$defs/gitSha"},
        "integration_candidate_sha": {"$ref": "https://schemas.hermes-pipeline.dev/common/definitions/v1#/$defs/gitSha"}
      }
    },
    "contract_revision": {"type": "integer", "minimum": 1},
    "artifacts": {"type": "array", "minItems": 1, "items": {"$ref": "https://schemas.hermes-pipeline.dev/common/definitions/v1#/$defs/artifactReference"}},
    "created_at": {"$ref": "https://schemas.hermes-pipeline.dev/common/definitions/v1#/$defs/utcTimestamp"},
    "bundle_digest": {"$ref": "https://schemas.hermes-pipeline.dev/common/definitions/v1#/$defs/sha256"}
  }
}
